{
  "name": "zalina/hijab-store",
  "type": "project",
  "description": "Zalina Fashion Laravel ecommerce",
  "require": {
    "php": "^8.2",
    "barryvdh/laravel-dompdf": "^3.1",
    "laravel/framework": "^12.0",
    "laravel/socialite": "^5.31",
    "phpoffice/phpspreadsheet": "^5.10"
  },
  "require-dev": {
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.13",
    "laravel/tinker": "^3.0",
    "phpstan/phpstan": "^2.2"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""], "post-create-project-cmd": ["@php artisan key:generate --ansi"]},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"pestphp/pest-plugin": true, "php-http/discovery": true}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
