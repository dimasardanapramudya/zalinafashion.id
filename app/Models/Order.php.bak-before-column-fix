    /*
    |--------------------------------------------------------------------------
    | QUERY SCOPES
    |--------------------------------------------------------------------------
    */


    public function scopePending(
        Builder $query
    ): Builder {

        return $query->where(

            'status',

            self::STATUS_PENDING

        );

    }




    public function scopePaid(
        Builder $query
    ): Builder {

        return $query->whereIn(

            'payment_status',

            [

                'paid',

                'success',

                'settled',

            ]

        );

    }




    public function scopeUnpaid(
        Builder $query
    ): Builder {

        return $query->whereNotIn(

            'payment_status',

            [

                'paid',

                'success',

                'settled',

            ]

        );

    }




    public function scopeDelivered(
        Builder $query
    ): Builder {

        return $query->where(

            'shipping_status',

            self::SHIPPING_DELIVERED

        );

    }




    public function scopeInShipping(
        Builder $query
    ): Builder {

        return $query->where(

            'shipping_status',

            self::SHIPPING_TRANSIT

        );

    }




    public function scopeReturnRequested(
        Builder $query
    ): Builder {

        return $query->where(

            'return_status',

            self::RETURN_REQUESTED

        );

    }




    public function scopeRefundPending(
        Builder $query
    ): Builder {

        return $query->where(

            'refund_status',

            self::REFUND_PENDING

        );

    }




