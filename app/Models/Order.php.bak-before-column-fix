    public function canRequestReturn(): bool
    {

        return

            $this->isDelivered()

            &&

            $this->return_status === self::RETURN_NONE;

    }





    public function canApproveReturn(): bool
    {

        return

            $this->return_status

            ===

            self::RETURN_REQUESTED;

    }





    public function canRejectReturn(): bool
