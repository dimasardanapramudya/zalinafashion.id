    public function getReturnSummary(): array
    {
        return [
            'status' => $this->return_status ?: 'none',
            'reason' => $this->return_reason ?? null,
            'note' => $this->return_note ?? null,
            'requested_at' => $this->return_requested_at ?? null,
            'approved_at' => $this->return_approved_at ?? null,
            'rejected_at' => $this->return_rejected_at ?? null,
            'completed_at' => $this->returned_at ?? null,
            'refund_status' => $this->refund_status ?? 'none',
        ];
    }

