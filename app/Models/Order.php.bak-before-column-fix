    }



    public function trackingUrl(): ?string
    {
        if (

            !$this->hasTracking()

        ) {

            return null;

        }


        return match(

            strtolower(
                $this->shipping_courier
            )

        ) {


            'jne' =>

                'https://www.jne.co.id/id/tracking',

            'jnt' =>

                'https://www.jet.co.id/track',

            'sicepat' =>

                'https://www.sicepat.com/checkAwb',

            'anteraja' =>

                'https://anteraja.id/tracking',

            default => null,

        };
    }



    public function shippingMethod(): string
    {
        $courier =
            strtoupper(
                $this->shipping_courier ?? ''
            );


        $service =
            strtoupper(
                $this->shipping_service ?? ''
            );


        return trim(

            $courier
            .' '
            .$service

        )
        ?: '-';
    }



    public function shippingWeight(): int
