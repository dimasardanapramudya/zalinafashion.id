    public function getShippingStatus(): string
    {
        if (

            empty($this->shipping_status)

        ) {

            return self::SHIPPING_WAITING;

        }


        if (

            !in_array(

                $this->shipping_status,

                self::shippingStatuses(),

                true

            )

        ) {

            return self::SHIPPING_WAITING;

        }


        return $this->shipping_status;
    }



    public function getShippingStatusLabel(): string
    {
        return self::shippingLabels()[

            $this->getShippingStatus()

        ] ?? 'Menunggu Diproses';
    }



    public function setShippingStatus(
        string $status
    ): bool {

        if (

            !in_array(

                $status,

                self::shippingStatuses(),

                true

            )

        ) {

            return false;

        }


        $this->shipping_status = $status;


        if (

            $status === self::SHIPPING_DELIVERED

        ) {

            $this->status =
                self::STATUS_DELIVERED;


            $this->delivered_at =
                now();

        }


        if (

            $status === self::SHIPPING_TRANSIT

        ) {

            $this->status =
                self::STATUS_SHIPPED;

        }


        return $this->save();
    }



