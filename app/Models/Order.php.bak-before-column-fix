    /*
    |--------------------------------------------------------------------------
    | BOOT EVENTS
    |--------------------------------------------------------------------------
    */


    protected static function booted(): void
    {

        static::creating(

            function($order){

                if(
                    empty($order->order_number)
                ){

                    $order->order_number =

                        'ZLH-'

                        .

                        now()->format('Ymd')

                        .

                        '-'

                        .

                        strtoupper(
                            substr(
                                md5(
                                    uniqid()
                                ),
                                0,
                                6
                            )
                        );

                }


                if(
                    empty($order->return_status)
                ){

                    $order->return_status =
                        self::RETURN_NONE;

                }


                if(
                    empty($order->refund_status)
                ){

                    $order->refund_status =
                        self::REFUND_NONE;

                }

            }

        );

    }




    
