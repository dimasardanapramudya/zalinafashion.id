    public function shippingStepCompleted(
        string $step
    ): bool {

        $steps =
            self::shippingStatuses();


        $current =
            array_search(

                $this->getShippingStatus(),

                $steps,

                true

            );


        $target =
            array_search(

                $step,

                $steps,

                true

            );


        if (

            $current === false ||

            $target === false

        ) {

            return false;

        }


        return $current >= $target;
    }



    public function isDelivered(): bool
    {
        return

