    /*
    |--------------------------------------------------------------------------
    | DELIVERY ESTIMATION
    |--------------------------------------------------------------------------
    */


    public function estimatedDeliveryDate(): ?Carbon
    {

        if (

            !$this->created_at

        ) {

            return null;

        }


        preg_match(

            '/\d+/',

            $this->shipping_etd ?? '',

            $match

        );


        $days =
            $match[0] ?? 0;


        return $days

            ? $this->created_at
                ->copy()
                ->addDays($days)

            : null;
    }
