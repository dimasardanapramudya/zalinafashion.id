APP_NAME="Zalina Fashion"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
LOG_CHANNEL=stack
LOG_LEVEL=debug

# XAMPP / phpMyAdmin (MySQL)
DB_CONNECTION=mysql
